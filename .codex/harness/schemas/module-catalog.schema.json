{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "codex-base/module-catalog.schema.json",
  "type": "object",
  "required": ["version", "modules"],
  "additionalProperties": false,
  "properties": {
    "version": {"const": 1},
    "globalPaths": {"type": "array", "items": {"type": "string"}},
    "ignored": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["pattern", "reason"],
        "additionalProperties": false,
        "properties": {"pattern": {"type": "string"}, "reason": {"type": "string", "minLength": 1}}
      }
    },
    "modules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "root", "paths", "dependsOn", "shared", "owners", "contracts", "tests", "verification"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
          "root": {"type": "string"},
          "paths": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "dependsOn": {"type": "array", "items": {"type": "string"}},
          "shared": {"type": "boolean"},
          "owners": {"type": "array", "items": {"type": "string"}},
          "contracts": {"type": "array", "items": {"type": "string"}},
          "capsule": {"type": "string"},
          "tests": {"type": "array", "items": {"type": "string"}},
          "verification": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
